# 替换 sub.example.com 为你的域名
sub.example.com {
	encode gzip
	reverse_proxy nodeharvest:8080

	# 可选：只暴露订阅，不暴露管理 API
	# @api path /api/*
	# respond @api 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
