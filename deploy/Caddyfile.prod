{$PUBLIC_DOMAIN} {
	encode zstd gzip
	@public path /sub* /api/sub* /api/health /api/ready /api/version /api/terms
	reverse_proxy @public nodeharvest:8080
	respond 404
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy nodeharvest:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
